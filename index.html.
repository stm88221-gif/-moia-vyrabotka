
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#176b55">
<title>Моя выработка</title>
<style>
:root{font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#202a27;background:#f3f6f5}
*{box-sizing:border-box}
body{margin:0;padding:16px 14px 35px;max-width:760px;margin-inline:auto}
h1{font-size:25px;margin:8px 0 5px}
.sub{color:#64736e;font-size:14px;margin-bottom:18px}
nav{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:16px}
nav button{padding:12px 4px;border:0;border-radius:12px;background:#e0e9e5;color:#24483d;font-weight:700}
nav button.active{background:#176b55;color:white}
.panel{background:white;border-radius:16px;padding:16px;margin-bottom:13px;box-shadow:0 2px 8px #19382a0d}
h2{font-size:19px;margin:0 0 13px}
label{display:block;font-size:14px;font-weight:600;margin:12px 0 6px}
input,select,textarea{font:inherit;width:100%;padding:12px;border:1px solid #ccd8d3;border-radius:10px;background:white;color:#202a27}
button.action{border:0;border-radius:11px;background:#176b55;color:white;font-weight:700;font-size:15px;padding:13px;width:100%;margin-top:12px}
button.secondary{background:#e4efea;color:#176b55}
.hidden{display:none!important}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:#eef5f1;border-radius:12px;padding:13px}
.stat small{display:block;color:#61736a;margin-bottom:6px}
.stat strong{font-size:23px}
.item{padding:12px 0;border-bottom:1px solid #e7ece9}
.item:last-child{border-bottom:0}
.itemtop{display:flex;justify-content:space-between;gap:10px;font-weight:700}
.muted{font-size:13px;color:#697771;margin-top:4px}
.danger{color:#a52e2e;background:#fae9e7}
.row{display:flex;gap:8px}
.row>*{flex:1;min-width:0}
.note{font-size:13px;color:#68776f;line-height:1.45}
</style>
</head>
<body>
<h1>Моя выработка</h1>
<div class="sub">Учёт изделий и рабочих баллов</div>

<nav>
<button class="active" data-tab="today">Запись</button>
<button data-tab="catalog">Каталог</button>
<button data-tab="report">Отчёт</button>
</nav>

<section id="today">
<div class="panel">
<h2>Добавить выполненную работу</h2>
<label for="workDate">Дата</label>
<input id="workDate" type="date">
<label for="productSelect">Изделие</label>
<select id="productSelect"></select>
<label for="quantity">Количество, шт.</label>
<input id="quantity" type="number" min="0.01" step="any" value="1">
<label for="workPoints">Баллов за 1 шт.</label>
<input id="workPoints" type="number" min="0" step="any" placeholder="Укажи баллы">
<label for="workNote">Примечание (необязательно)</label>
<input id="workNote" placeholder="Например, номер заказа">
<button class="action" id="saveWork">Сохранить запись</button>
</div>
<div class="panel">
<h2>Записи за выбранную дату</h2>
<div id="dayEntries"></div>
</div>
</section>

<section id="catalog" class="hidden">
<div class="panel">
<h2>Добавить изделие</h2>
<label for="productName">Название</label>
<input id="productName" placeholder="Например, Узел 1">
<label for="productPoints">Баллов за штуку</label>
<input id="productPoints" type="number" min="0" step="any" placeholder="Например, 0.7">
<label for="productNote">Примечание</label>
<input id="productNote" placeholder="Необязательно">
<button class="action" id="saveProduct">Сохранить изделие</button>
</div>
<div class="panel">
<h2>Мой каталог</h2>
<div id="productList"></div>
</div>
</section>

<section id="report" class="hidden">
<div class="panel">
<h2>Месячный отчёт</h2>
<label for="reportMonth">Месяц</label>
<input id="reportMonth" type="month">
<div class="stats">
<div class="stat"><small>Всего баллов</small><strong id="totalPoints">0</strong></div>
<div class="stat"><small>Рабочих дней с записями</small><strong id="workDays">0</strong></div>
<div class="stat"><small>Среднее за день</small><strong id="averagePoints">0</strong></div>
<div class="stat"><small>Записей</small><strong id="entryCount">0</strong></div>
</div>
<button class="action" id="exportCsv">Скачать CSV для Excel</button>
<button class="action secondary" id="backup">Резервная копия JSON</button>
<label for="restoreFile">Восстановить из JSON</label>
<input id="restoreFile" type="file" accept=".json,application/json">
<button class="action secondary" id="printReport">Печать / сохранить PDF</button>
<p class="note">Среднее считается по датам, в которые есть хотя бы одна запись. Перед очисткой данных браузера сделай резервную копию.</p>
</div>
<div class="panel">
<h2>Работы за месяц</h2>
<div id="monthEntries"></div>
</div>
</section>

<script>
(function(){
"use strict";
const $=id=>document.getElementById(id);
const today=new Date();
const iso=d=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
const monthNow=iso(today).slice(0,7);
$("workDate").value=iso(today);
$("reportMonth").value=monthNow;

let state={products:[],entries:[]};
try{
 const raw=localStorage.getItem("moiaVyrabotkaData");
 if(raw){const parsed=JSON.parse(raw);if(parsed&&Array.isArray(parsed.products)&&Array.isArray(parsed.entries))state=parsed;}
}catch(e){}
function save(){try{localStorage.setItem("moiaVyrabotkaData",JSON.stringify(state));}catch(e){alert("Не удалось сохранить данные в браузере. Сделай резервную копию JSON.");}}
function num(n){return Number(n||0).toLocaleString("ru-RU",{maximumFractionDigits:3});}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function tab(name){
 ["today","catalog","report"].forEach(t=>$(t).classList.toggle("hidden",t!==name));
 document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("active",b.dataset.tab===name));
 if(name==="catalog")renderCatalog();
 if(name==="today")renderDay();
 if(name==="report")renderReport();
}
document.querySelector("nav").addEventListener("click",e=>{
 const b=e.target.closest("button[data-tab]");
 if(b){e.preventDefault();tab(b.dataset.tab);}
});
function renderSelect(selected){
 const s=$("productSelect");
 s.innerHTML='<option value="">— Выбери изделие —</option>'+state.products.map(p=>`<option value="${esc(p.id)}">${esc(p.name)}</option>`).join("")+'<option value="__new">＋ Добавить новое изделие…</option>';
 if(selected)s.value=selected;
}
$("productSelect").addEventListener("change",()=>{
 const id=$("productSelect").value;
 if(id==="__new"){tab("catalog");$("productName").focus();return;}
 const p=state.products.find(x=>x.id===id);
 if(p)$("workPoints").value=p.points;
});
$("saveProduct").addEventListener("click",()=>{
 const name=$("productName").value.trim(), points=$("productPoints").value;
 if(!name){alert("Введи название изделия.");return;}
 if(points===""||!Number.isFinite(Number(points))||Number(points)<0){alert("Введи корректное количество баллов.");return;}
 const existing=state.products.find(p=>p.name.toLowerCase()===name.toLowerCase());
 if(existing){
  if(!confirm("Такое изделие уже есть. Обновить его баллы?"))return;
  existing.points=Number(points);existing.note=$("productNote").value.trim();
  renderSelect(existing.id);
 }else{
  const p={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),name,points:Number(points),note:$("productNote").value.trim()};
  state.products.push(p);renderSelect(p.id);
 }
 save();$("productName").value="";$("productPoints").value="";$("productNote").value="";
 renderCatalog();tab("today");$("workPoints").value=state.products.find(p=>p.id===$("productSelect").value)?.points??"";
});
function renderCatalog(){
 $("productList").innerHTML=state.products.length?state.products.map(p=>`
 <div class="item">
  <div class="itemtop"><span>${esc(p.name)}</span><span>${num(p.points)} б.</span></div>
  ${p.note?`<div class="muted">${esc(p.note)}</div>`:""}
  <div class="row">
   <button class="action secondary" data-edit="${esc(p.id)}">Изменить</button>
   <button class="action danger" data-delete="${esc(p.id)}">Удалить</button>
  </div>
 </div>`).join(""):'<p class="note">Каталог пока пуст. Добавь первое изделие выше.</p>';
}
$("productList").addEventListener("click",e=>{
 const edit=e.target.closest("[data-edit]")?.dataset.edit;
 const del=e.target.closest("[data-delete]")?.dataset.delete;
 if(edit){
  const p=state.products.find(x=>x.id===edit);if(!p)return;
  $("productName").value=p.name;$("productPoints").value=p.points;$("productNote").value=p.note||"";
  state.products=state.products.filter(x=>x.id!==edit);save();renderCatalog();renderSelect();tab("catalog");
  $("productName").focus();
 }
 if(del){
  const p=state.products.find(x=>x.id===del);if(!p)return;
  if(confirm(`Удалить «${p.name}» из каталога? Старые записи сохранятся.`)){
   state.products=state.products.filter(x=>x.id!==del);save();renderCatalog();renderSelect();
  }
 }
});
$("saveWork").addEventListener("click",()=>{
 const date=$("workDate").value,id=$("productSelect").value,q=Number($("quantity").value),pts=$("workPoints").value;
 if(!date){alert("Выбери дату.");return;}
 if(!id||id==="__new"){alert("Выбери изделие из каталога.");return;}
 if(!Number.isFinite(q)||q<=0){alert("Количество должно быть больше нуля.");return;}
 if(pts===""||!Number.isFinite(Number(pts))||Number(pts)<0){alert("Введи корректные баллы за штуку.");return;}
 const p=state.products.find(x=>x.id===id);if(!p){alert("Изделие не найдено. Выбери его снова.");return;}
 const unitPoints=Number(pts);
 state.entries.push({id:Date.now().toString()+Math.random().toString(16).slice(2),date,productId:id,productName:p.name,quantity:q,unitPoints,total:q*unitPoints,note:$("workNote").value.trim()});
 // Current product price is remembered for future entries; existing records keep their snapshot.
 p.points=unitPoints;save();
 $("quantity").value="1";$("workNote").value="";
 renderSelect(id);renderDay();alert("Запись сохранена!");
});
$("workDate").addEventListener("change",renderDay);
function renderDay(){
 const date=$("workDate").value;
 const arr=state.entries.filter(e=>e.date===date);
 $("dayEntries").innerHTML=arr.length?arr.map(e=>`<div class="item"><div class="itemtop"><span>${esc(e.productName)} × ${num(e.quantity)}</span><span>${num(e.total)} б.</span></div><div class="muted">${num(e.unitPoints)} б./шт.${e.note?" · "+esc(e.note):""}</div><button class="action danger" data-entry-delete="${esc(e.id)}">Удалить запись</button></div>`).join(""):'<p class="note">На эту дату записей пока нет.</p>';
}
$("dayEntries").addEventListener("click",e=>{
 const id=e.target.closest("[data-entry-delete]")?.dataset.entryDelete;
 if(id&&confirm("Удалить эту запись?")){state.entries=state.entries.filter(x=>x.id!==id);save();renderDay();renderReport();}
});
function monthly(){
 const m=$("reportMonth").value;
 return state.entries.filter(e=>e.date.startsWith(m)).sort((a,b)=>a.date.localeCompare(b.date));
}
function renderReport(){
 const arr=monthly(),days=new Set(arr.map(e=>e.date));
 const total=arr.reduce((s,e)=>s+Number(e.total||0),0);
 $("totalPoints").textContent=num(total);$("workDays").textContent=days.size;
 $("averagePoints").textContent=num(days.size?total/days.size:0);$("entryCount").textContent=arr.length;
 $("monthEntries").innerHTML=arr.length?arr.map(e=>`<div class="item"><div class="itemtop"><span>${esc(e.date)} · ${esc(e.productName)}</span><span>${num(e.total)} б.</span></div><div class="muted">${num(e.quantity)} шт. × ${num(e.unitPoints)} б.</div></div>`).join(""):'<p class="note">За этот месяц записей пока нет.</p>';
}
$("reportMonth").addEventListener("change",renderReport);
$("exportCsv").addEventListener("click",()=>{
 const arr=monthly(),rows=[["Дата","Изделие","Количество","Баллов за штуку","Всего баллов","Примечание"],...arr.map(e=>[e.date,e.productName,e.quantity,e.unitPoints,e.total,e.note||""])];
 const csv="\uFEFF"+rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(";")).join("\r\n");
 download(csv,"vyработка-"+$("reportMonth").value+".csv","text/csv;charset=utf-8");
});
$("backup").addEventListener("click",()=>download(JSON.stringify(state,null,2),"vyработка-backup-"+iso(today)+".json","application/json"));
$("restoreFile").addEventListener("change",async e=>{
 const file=e.target.files[0];if(!file)return;
 try{const data=JSON.parse(await file.text());if(!data||!Array.isArray(data.products)||!Array.isArray(data.entries))throw Error("format");
  if(confirm("Заменить текущие данные данными из резервной копии?")){state=data;save();renderSelect();renderCatalog();renderDay();renderReport();alert("Данные восстановлены.");}
 }catch(err){alert("Не удалось прочитать резервную копию JSON.");}
 e.target.value="";
});
$("printReport").addEventListener("click",()=>window.print());
function download(content,name,type){
 const blob=new Blob([content],{type}),url=URL.createObjectURL(blob),a=document.createElement("a");
 a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
renderSelect();renderCatalog();renderDay();renderReport();
})();
</script>
</body>
</html>
